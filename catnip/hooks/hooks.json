{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/plan-word-count.py"
          }
        ]
      },
      {
        "matcher": "Write|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/allow-clarification-notes.py"
          }
        ]
      }
    ]
  }
}
